<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\..\dep\msvc\vsprops\Configurations.props" />

  <ItemGroup>
    <ClCompile Include="scmversion.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="scmversion.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="gen_scmversion.bat" />
    <None Include="gen_scmversion.sh" />
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{075CED82-6A20-46DF-94C7-9624AC9DDBEB}</ProjectGuid>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <Import Project="..\..\dep\msvc\vsprops\StaticLibrary.props" />

  <PropertyGroup>
    <CustomBuildBeforeTargets>PreBuildEvent</CustomBuildBeforeTargets>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <PreBuildEvent />
    <PreBuildEvent />
    <CustomBuildStep>
      <Command>cmd /k "$(ProjectDir)gen_scmversion.bat"</Command>
    </CustomBuildStep>
    <CustomBuildStep>
      <Message>Checking whether scmversion.cpp needs updating...</Message>
    </CustomBuildStep>
    <!-- A file that is never created, so the step runs on every build. With scmversion.cpp as the
         output it was skipped once that file existed, leaving a stale version after commits and tags.
         gen_scmversion.bat only rewrites scmversion.cpp when the version has changed. -->
    <CustomBuildStep>
      <Outputs>$(IntDir)scmversion.always-run</Outputs>
    </CustomBuildStep>
  </ItemDefinitionGroup>

  <Import Project="..\..\dep\msvc\vsprops\Targets.props" />
</Project>